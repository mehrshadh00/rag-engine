# Local embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB persistence
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=knowledge_base

# Chunking and retrieval
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5

# Retrieval mode: hybrid (default), dense, or bm25
RETRIEVAL_MODE=hybrid
HYBRID_CANDIDATE_K=50
RRF_K=60
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=1.0

# Optional Cross-Encoder reranking (disabled by default)
RERANK_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_K=20

# Abstain when the top Cross-Encoder relevance score is below this threshold.
# This gate runs only when RERANK_ENABLED=true; validate threshold on your dev set.
ANSWERABILITY_ENABLED=true
ANSWERABILITY_THRESHOLD=0.67

# LLM answer generation (optional for ingestion/retrieval)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
