{
  "name": "RAG Fundamentals Retrieval Benchmark",
  "version": "2.0.0",
  "description": "A document-level retrieval benchmark over the versioned 15-document RAG fundamentals corpus. Includes direct factual questions, semantic paraphrases, exact terminology, multi-hop evidence requirements, and unanswerable queries.",
  "corpus": {
    "id": "rag_fundamentals_corpus_v2",
    "path": "benchmarks/corpus_v2",
    "document_count": 15
  },
  "evaluation_level": "document",
  "label_policy": {
    "relevance_unit": "source_document",
    "relevant_sources": "All corpus documents containing evidence that materially supports an answer. Empty for unanswerable queries.",
    "required_sources": "For multi-hop queries, every source needed to support a complete answer. Empty for other categories.",
    "answerable": "True only when the corpus contains sufficient evidence to answer the query.",
    "split": "Each category has 12 dev queries and 8 held-out test queries. Do not tune retrieval parameters on test queries."
  },
  "category_counts": {
    "direct": 20,
    "paraphrase": 20,
    "exact_term": 20,
    "multi_hop": 20,
    "unanswerable": 20
  },
  "split_counts": {
    "dev": 60,
    "test": 40
  },
